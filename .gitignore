# Ambiente virtual
.venv/

# Python
__pycache__/
*.py[cod]

# Variáveis de ambiente e credenciais
.env
.env.*
!.env.example

# Jupyter
.ipynb_checkpoints/

# Testes e ferramentas
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Dados locais
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Modelos e artefatos gerados
artifacts/*
!artifacts/.gitkeep

# Arquivos gerados pelo PyInstaller
/build/
/dist/